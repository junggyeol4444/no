# ── AI 공급자 선택 ────────────────────────────────────────────────
# ollama  = 로컬 LLM (기본값, API 키·인터넷 불필요)
# anthropic = Claude 클라우드 (ANTHROPIC_API_KEY 필요)
# AI_PROVIDER=ollama

# ── 로컬 LLM (Ollama) ─────────────────────────────────────────────
# 1) 설치: https://ollama.com  (macOS/Windows/Linux)
# 2) 모델 받기: ollama pull qwen2.5:7b   (한국어 무난. 가벼운 PC면 qwen2.5:3b)
# 3) 실행 중인지 확인: ollama serve  (앱 설치 시 보통 자동 실행)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── 클라우드 (Anthropic Claude) — AI_PROVIDER=anthropic 일 때만 ────
# 키 발급: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 공개 사이트 주소 (선택) ──────────────────────────────────────
# 자동 업로드 시 보낼 독자 페이지 링크의 기준 주소. 배포 시 설정.
# 미설정이면 요청 host 에서 추론.
# PUBLIC_BASE_URL=https://novel.example.com

# ── 접근 비밀번호 (선택) ──────────────────────────────────────────
# 설정하면 로그인 화면이 활성화됩니다. (외부 배포 시 기본 차단용)
# 미설정이면 로컬에서 비밀번호 없이 바로 사용.
# APP_PASSWORD=

# ── DB (선택) ─────────────────────────────────────────────────────
# DATABASE_PATH=./data/webnovel.db
